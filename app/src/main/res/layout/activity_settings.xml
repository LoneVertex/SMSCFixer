<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIM1 / Primary SMSC" />

        <EditText
            android:id="@+id/primarySmscInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="+20105996500"
            android:inputType="phone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SIM2 / Secondary SMSC" />

        <EditText
            android:id="@+id/secondarySmscInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="+20122000020"
            android:inputType="phone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Target app packages (comma-separated). android framework is always allowed." />

        <EditText
            android:id="@+id/targetPackagesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="com.google.android.apps.messaging,com.android.mms" />

        <CheckBox
            android:id="@+id/diagnosticsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enable extra diagnostics logging" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save settings" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
