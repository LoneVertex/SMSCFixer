<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sg_field_focused" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sg_teal" />
            <padding
                android:left="14dp"
                android:top="12dp"
                android:right="14dp"
                android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sg_field" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/sg_stroke" />
            <padding
                android:left="14dp"
                android:top="12dp"
                android:right="14dp"
                android:bottom="12dp" />
        </shape>
    </item>
</selector>
